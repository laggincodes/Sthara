# 3D Cadastral Intelligence - Backend Environment Configuration Template
# Copy this file to .env and adjust values for your environment.

# Service Configuration
PROJECT_NAME="3D Cadastral Intelligence API"
VERSION="1.0.0"
ENVIRONMENT="development"
HOST="0.0.0.0"
PORT=8000
API_V1_STR="/api/v1"

# Security & CORS (Comma-separated list or JSON array; never use wildcard "*" in production)
FRONTEND_URL="http://localhost:3000"
ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Logging (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL="INFO"
