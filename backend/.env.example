# ==============================================================================
# STHARA FASTAPI BACKEND ENVIRONMENT VARIABLES (Deployment Platform)
# ==============================================================================
# Copy this file to .env for local backend development.
# For Production deployment (Render / Railway / Fly.io / AWS), set these variables
# in your hosting platform's environment settings.

# ------------------------------------------------------------------------------
# 1. RUNTIME ENVIRONMENT
# ------------------------------------------------------------------------------
# Options: development | production | test
# Set to 'production' on your deployed backend server.
ENVIRONMENT=development

# ------------------------------------------------------------------------------
# 2. CORS ORIGINS (Required for Production Security)
# ------------------------------------------------------------------------------
# Comma-separated list of allowed frontend origins that can make API calls to this backend.
# Local Development default: http://localhost:3000,http://127.0.0.1:3000
# Production value:           https://<VERCEL-FRONTEND-DOMAIN>,http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Primary frontend URL reference
FRONTEND_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 3. LOGGING CONFIGURATION (Optional)
# ------------------------------------------------------------------------------
# Logging verbosity level. Options: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# 4. SERVER BINDING (Optional - Managed automatically by Render / Railway)
# ------------------------------------------------------------------------------
# Host interface and port for Uvicorn runner.
HOST=0.0.0.0
PORT=8000
