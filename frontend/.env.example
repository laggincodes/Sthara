# 3D Cadastral Intelligence - Frontend Environment Configuration Template
# Copy this file to .env.local and adjust values for your environment.

# Backend Authoritative API Base URL (including /api/v1 prefix)
NEXT_PUBLIC_API_URL="http://localhost:8000/api/v1"

# Optional: Public site URL for canonical links and OpenGraph
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Optional MapLibre Vector Tile Basemap Style (defaults to Carto Dark Matter)
# NEXT_PUBLIC_MAP_STYLE_URL="https://basemaps.cartocdn.com/gl/dark-matter-gl-style/style.json"
