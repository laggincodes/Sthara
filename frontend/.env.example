# ==============================================================================
# STHARA FRONTEND ENVIRONMENT VARIABLES (Vercel & Next.js)
# ==============================================================================
# Copy this file to .env.local for local development.
# For Vercel production deployment, set these variables in Vercel Project Settings -> Environment Variables.

# ------------------------------------------------------------------------------
# 1. API CONNECTION (Required)
# ------------------------------------------------------------------------------
# Base URL for the FastAPI backend API endpoints.
# Local Development default: http://localhost:8000/api/v1
# Vercel Production value:   https://<DEPLOYED-BACKEND-URL>/api/v1
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# ------------------------------------------------------------------------------
# 2. CANONICAL SITE URL (Required for Production SEO / OpenGraph)
# ------------------------------------------------------------------------------
# Public URL where the frontend is deployed.
# Local Development default: http://localhost:3000
# Vercel Production value:   https://<VERCEL-FRONTEND-DOMAIN>
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 3. GEOSPATIAL MAP STYLE (Optional)
# ------------------------------------------------------------------------------
# Vector tile style URL for MapLibre 2D GIS rendering.
# Defaults to CartoDB Dark Matter if omitted or empty.
NEXT_PUBLIC_MAP_STYLE_URL=https://basemaps.cartocdn.com/gl/dark-matter-gl-style/style.json
